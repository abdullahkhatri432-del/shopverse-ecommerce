# Server
PORT=4000
# Change this in production!
JWT_SECRET=dev-secret-change-me

# Currency used for payments (INR or USD). Prices are stored in the smallest
# unit (paise/cents), so a product priced 19900 = 199.00 of this currency.
CURRENCY=INR

# CORS origin for the frontend (comma-separated list allowed). Use * to allow any.
CORS_ORIGIN=http://localhost:5173

# Admin seed account (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Optional: Razorpay test keys (rzp_test_...). Leave blank to use the built-in mock checkout.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Store / legal details (shown on invoices and legal pages).
# STORE_GSTIN is optional; leave blank until your GST registration is done.
# ---------------------------------------------------------------------------
STORE_NAME=ShopVerse
STORE_LEGAL_NAME=Your Legal Business Name
STORE_PROPRIETOR=Your Full Name
STORE_ADDRESS=Your Registered Address, City, State, PIN
STORE_EMAIL=support@yourstore.com
STORE_PHONE=+91 90000 00000
STORE_WEBSITE=www.yourstore.com

# GST details (required once you are GST-registered). State code is 2 letters, e.g. DL for Delhi.
STORE_GSTIN=
STORE_STATE=DL
STORE_STATE_NAME=Delhi

# Grievance officer (required by the IT Act and Consumer Protection E-Commerce Rules).
GRIEVANCE_OFFICER_NAME=Your Name
GRIEVANCE_OFFICER_EMAIL=grievance@yourstore.com
GRIEVANCE_OFFICER_PHONE=+91 90000 00000
