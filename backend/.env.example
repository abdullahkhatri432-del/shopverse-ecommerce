# Server
PORT=4000
# Change this in production!
JWT_SECRET=dev-secret-change-me

# Currency used for payments (INR or USD). Prices are stored in the smallest
# unit (paise/cents), so a product priced 19900 = 199.00 of this currency.
CURRENCY=INR

# Admin seed account (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Optional: Razorpay test keys (rzp_test_...). Leave blank to use the built-in mock checkout.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
